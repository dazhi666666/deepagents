{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "mars",
  "model": "dspark/dsv4f-native",
  "compaction": {
    "auto": true,
    "reserved": 20000
  },
  "provider": {
    "dspark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DSPARK lab gateway",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "local-proxy"
      },
      "models": {
        "dsv4f-native": {
          "name": "dsv4f-native",
          "limit": {
            "context": 131072,
            "output": 30000
          }
        }
      }
    }
  }
}
